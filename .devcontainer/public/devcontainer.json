{
    "name": "${localWorkspaceFolderBasename}-public",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../.."
    },
    "customizations": {
        "vscode": {
            "settings": {
            },
            "extensions": [
                "mads-hartmann.bash-ide-vscode",
                "ms-azuretools.vscode-containers",
                "github.vscode-github-actions"
            ]
        }
    },
    "privileged": true,
    "runArgs": [
        "--rm"
    ],
    "mounts": [
        "type=volume,target=/var/lib/docker-in-docker"
    ],
    "postStartCommand": "sudo docker-in-docker start",
    "remoteUser": "dev"
}
